  "questions": [
    {
      "id": "q1",
      "stem": {
        "ar": "متى يكون المتحكم الضبابي الأداة المناسبة؟",
        "en": "When is a fuzzy controller the right tool?"
      },
      "bloom": "Understand",
      "answer": 2,
      "options": [
        {
          "ar": "ساكن ومحدد بدقة هنا",
          "en": "static and exactly known"
        },
        {
          "ar": "نموذج واحد ثابت هنا",
          "en": "single and fixed model now"
        },
        {
          "ar": "غير خطي ومتغير بالوقت",
          "en": "nonlinear and time-varying"
        },
        {
          "ar": "خطي ومعروف تماماً هنا",
          "en": "linear and fully known now"
        }
      ],
      "concept_id": "c5c_when",
      "explanation": {
        "ar": "المتحكم الضبابي يناسب الأنظمة غير الخطية والمتغيرة والمشوشة.",
        "en": "An FLC suits nonlinear, time-varying and noisy systems."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "أي مكونات تشكّل متحكماً منطقياً ضبابياً؟",
        "en": "Which components make up a fuzzy logic controller?"
      },
      "bloom": "Remember",
      "answer": 1,
      "options": [
        {
          "ar": "جمع وضرب ومتوسط هنا",
          "en": "sum product and average here"
        },
        {
          "ar": "تحويل واستدلال وإزالة",
          "en": "fuzzify, infer and defuzzify"
        },
        {
          "ar": "اتحاد وتقاطع ومتمم هنا",
          "en": "union intersection complement"
        },
        {
          "ar": "أقصى-أدنى وأقصى-ضرب",
          "en": "max-min and max-product only"
        }
      ],
      "concept_id": "c5c_components",
      "explanation": {
        "ar": "المتحكم يحوّل ضبابياً، يستدل عبر القواعد، ثم يزيل التغبيش.",
        "en": "An FLC fuzzifies, infers over the rules, then defuzzifies."
      }
    },
