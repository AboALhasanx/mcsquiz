  "questions": [
    {
      "id": "q1",
      "stem": {
        "ar": "كيف يُحسب دعم القاعدة؟",
        "en": "How is the Support of a rule computed?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "عدّ الاتحاد على الكل",
          "en": "union count over total"
        },
        {
          "ar": "عدّ السابق على الكل",
          "en": "antecedent over total"
        },
        {
          "ar": "عدّ اللاحق على الكل",
          "en": "consequent over total"
        },
        {
          "ar": "عدّ عنصر واحد على الكل",
          "en": "single item over total"
        }
      ],
      "concept_id": "c5m_sup_formula",
      "explanation": {
        "ar": "الدعم هو عدّ X وY معاً مقسوماً على N.",
        "en": "Support is the count of X and Y together divided by N."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "كيف تُحسب ثقة القاعدة؟",
        "en": "How is the Confidence of a rule computed?"
      },
      "bloom": "Remember",
      "answer": 1,
      "options": [
        {
          "ar": "عدّ السابق على اللاحق",
          "en": "antecedent over consequent"
        },
        {
          "ar": "عدّ الاتحاد على السابق",
          "en": "union count over antecedent"
        },
        {
          "ar": "عدّ الاتحاد على الكل هنا",
          "en": "union count over total"
        },
        {
          "ar": "عدّ اللاحق على السابق",
          "en": "consequent over antecedent"
        }
      ],
      "concept_id": "c5m_conf_formula",
      "explanation": {
        "ar": "الثقة تقسم عدّ الاتحاد على عدّ السابق.",
        "en": "Confidence divides the joint count by the antecedent count."
      }
    },
    {
      "id": "q3",
      "stem": {
        "ar": "على ماذا يقسم الرفع الدعم المشترك؟",
        "en": "What does the Lift formula divide joint support by?"
      },
      "bloom": "Understand",
      "answer": 2,
      "options": [
        {
          "ar": "عدد المعاملات كلها",
          "en": "count of all transactions"
        },
        {
          "ar": "ثقة القاعدة نفسها",
          "en": "confidence of the rule here"
        },
        {
          "ar": "حاصل ضرب الدعمين",
          "en": "product of single supports"
        },
        {
          "ar": "مجموع الدعمين معاً",
          "en": "sum of the single supports"
        }
      ],
      "concept_id": "c5m_lift_formula",
      "explanation": {
        "ar": "الرفع يقسم الدعم المشترك على حاصل ضرب الدعمين الفرديين.",
        "en": "Lift divides joint support by the product of the two single supports."
      }
    },
