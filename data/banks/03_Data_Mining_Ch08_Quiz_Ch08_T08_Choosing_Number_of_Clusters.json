          "en": "object is clear noise here"
        }
      ],
      "concept_id": "c8_k_sil_neg",
      "explanation": {
        "ar": "دون 0 يشير إلى أن العنصر قد ينتمي لعنقود مختلف عن المسند.",
        "en": "Below 0 suggests the object may belong to a different cluster than assigned."
      }
    },
    {
      "id": "q8",
      "stem": {
        "ar": "ما معادلة الظلال s(i)؟",
        "en": "What is the Silhouette formula s(i)?"
      },
      "bloom": "Remember",
      "answer": 3,
      "options": [
        {
          "ar": "(a-b) / min(a,b)",
          "en": "(a-b) / min(a,b)"
        },
        {
          "ar": "a زائد b بالكامل",
          "en": "a plus b all over"
        },
        {
          "ar": "max(a,b) لوحده",
          "en": "max(a,b) alone"
        },
        {
          "ar": "(b-a) / max(a,b)",
          "en": "(b-a) / max(a,b)"
        }
      ],
      "concept_id": "c8_k_sil_form",
      "explanation": {
        "ar": "s(i) = (b-a) / max(a,b)، حيث a متوسط عنقوده وb متوسط أقرب عنقود.",
        "en": "s(i) = (b-a) / max(a,b), where a is the own-cluster mean and b the nearest mean."
      }
    }
