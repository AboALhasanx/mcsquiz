      "bloom": "Remember",
      "answer": 3,
      "options": [
        {
          "ar": "عدد نقاط الضجيج هنا",
          "en": "the count of noise points"
        },
        {
          "ar": "عدد الميزات الكلية",
          "en": "the number of features"
        },
        {
          "ar": "تسمية فئة معروفة فقط",
          "en": "a known class label here"
        },
        {
          "ar": "ملاءمة مقابل أقرب آخر",
          "en": "cluster fit versus nearest"
        }
      ],
      "concept_id": "c8_k_sil_def",
      "explanation": {
        "ar": "يقيس مدى ملاءمة كل عنصر لعنقوده مقابل أقرب عنقود آخر.",
        "en": "It measures how well each object fits its cluster versus the nearest other cluster."
      }
    },
    {
      "id": "q5",
      "stem": {
        "ar": "ماذا تخبرك قيمة ظلال قريبة من +1؟",
        "en": "What does a silhouette value close to +1 tell you?"
      },
      "bloom": "Understand",
      "answer": 0,
      "options": [
        {
          "ar": "العنصر ملائم جيداً",
          "en": "object fits cluster well"
        },
        {
          "ar": "العنصر ضجيج واضح تماماً",
          "en": "object is clear noise here"
        },
        {
          "ar": "تسمية معروفة مسبقاً",
          "en": "a known class label only"
        },
        {
          "ar": "العنصر ميزاته قليلة",
          "en": "object has few features now"
        }
      ],
      "concept_id": "c8_k_sil_pos",
      "explanation": {
        "ar": "قرب +1 يعني أن العنصر يلائم عنقوده أفضل بكثير من التالي.",
        "en": "Near +1 means the object fits its own cluster much better than the next one."
      }
    },
    {
      "id": "q6",
      "stem": {
        "ar": "ماذا تعني قيمة ظلال قريبة من 0؟",
        "en": "What does a silhouette value close to 0 mean?"
      },
      "bloom": "Understand",
      "answer": 1,
      "options": [
        {
          "ar": "العنصر ميزاته كثيرة",
          "en": "object has many features"
        },
        {
          "ar": "العنصر قريب من حد ما",
          "en": "object near a boundary"
        },
        {
          "ar": "العنصر ضجيج واضح تماماً",
          "en": "object is clear noise here"
        },
        {
          "ar": "تسمية معروفة مسبقاً",
          "en": "a known class label only"
        }
      ],
      "concept_id": "c8_k_sil_zero",
      "explanation": {
        "ar": "حول 0 يعني أن العنصر يقع قرب حد بين عنقودين.",
        "en": "Around 0 means the object sits near a boundary between two clusters."
