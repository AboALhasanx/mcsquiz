    },
    {
      "id": "q7",
      "stem": {
        "ar": "ماذا تشير إليه قيمة ظلال سالبة؟",
        "en": "What does a negative silhouette value suggest?"
      },
      "bloom": "Understand",
      "answer": 2,
      "options": [
        {
          "ar": "تسمية معروفة مسبقاً",
          "en": "a known class label only"
        },
        {
