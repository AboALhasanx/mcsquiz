  "questions": [
    {
      "id": "q1",
      "stem": {
        "ar": "مع 5 معاملات وحد أدنى 40%، كم معاملة يجب أن تحوي المجموعة؟",
        "en": "With 5 transactions and min_sup 40%, how many must contain an itemset?"
      },
      "bloom": "Apply",
      "answer": 0,
      "options": [
        {
          "ar": "معاملتان على الأقل",
          "en": "at least two transactions"
        },
        {
          "ar": "ثلاث معاملات فقط",
          "en": "at least three transactions"
        },
        {
          "ar": "أربع معاملات فقط",
          "en": "at least four transactions"
        },
        {
          "ar": "معاملة واحدة فقط هنا",
          "en": "at least one transaction"
        }
      ],
      "concept_id": "c5w_minsup_2",
      "explanation": {
        "ar": "5 ضرب 0.40 يساوي 2، فالمجموعة يجب أن تظهر في معاملتين على الأقل.",
        "en": "5 times 0.40 equals 2, so the itemset must appear in at least two."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "بحد 40% و5 معاملات، هل الخبز والحليب والقهوة متكررة؟",
        "en": "At 40% with 5 transactions, is Bread,Milk,Coffee frequent?"
      },
      "bloom": "Apply",
      "answer": 1,
      "options": [
        {
          "ar": "لا، الدعم 80%",
          "en": "no, support is 80%"
        },
        {
          "ar": "لا، الدعم 20%",
          "en": "no, support is 20%"
        },
        {
          "ar": "نعم، الدعم 60%",
          "en": "yes, support is 60%"
        },
        {
          "ar": "نعم، الدعم 40%",
          "en": "yes, support is 40%"
        }
      ],
      "concept_id": "c5w_breadmilkcoffee_not",
      "explanation": {
        "ar": "تظهر في واحدة من خمس معاملات، فالدعم 20% وهي غير متكررة.",
        "en": "It appears in one of five transactions, so support is 20% and it is not frequent."
      }
    },
    {
