      "bloom": "Understand",
      "answer": 3,
      "options": [
        {
          "ar": "فشلان هنا أيضاً",
          "en": "two failures now here"
        },
        {
          "ar": "أعطال كثيرة مجدداً",
          "en": "many failures too now"
        },
        {
          "ar": "كل ما سبق أعلاه",
          "en": "all of the above answers"
        },
        {
          "ar": "فشل واحد الآن هنا",
          "en": "one failure here again"
        }
      ],
      "concept_id": "ch7_fault_failures",
      "explanation": {
        "ar": "العطل الواحد الكامن قد يظهر كأعطال مختلفة في ظروف مختلفة.",
        "en": "A single latent fault can surface as many different failures in different situations."
      }
    },
