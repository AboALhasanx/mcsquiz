    {
      "id": "q5",
      "stem": {
        "ar": "متى ينبغي إعطاء الأولوية لـPrecision؟",
        "en": "When should precision be prioritized?"
      },
      "bloom": "Understand",
      "answer": 1,
      "options": [
        {
          "ar": "عندما يكون تفويت حالة موجبة هو مصدر القلق الوحيد",
