    {
      "id": "q1",
      "stem": {
        "ar": "ماذا تقيس الدقة؟",
        "en": "What does accuracy measure?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "نسبة جميع التنبؤات الصحيحة",
          "en": "the percentage of all predictions that are correct"
        },
        {
          "ar": "أنماطاً تميّز فئة عن أخرى",
          "en": "patterns that distinguish one class from another"
        },
        {
          "ar": "يواصل التقسيم حتى عزل كل سجل.",
          "en": "Continue splitting until every record is isolated."
        },
        {
          "ar": "عندما تكون أسماء الفئات متطابقة",
          "en": "when the classes have identical names"
        }
      ],
      "concept_id": "c6_accuracy_meaning",
      "explanation": {
        "ar": "نسبة جميع التنبؤات الصحيحة",
        "en": "Accuracy measures the percentage of all predictions that are correct."
      }
    },
    {
