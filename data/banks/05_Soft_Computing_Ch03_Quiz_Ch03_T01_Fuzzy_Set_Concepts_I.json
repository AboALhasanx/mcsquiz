    {
      "id": "q1",
      "stem": {
        "ar": "ما هو دعم المجموعة الضبابية؟",
        "en": "What is the support of a fuzzy set?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "نقاط درجتها فوق الصفر",
          "en": "points with grade above zero"
        },
        {
          "ar": "نقاط درجتها تساوي واحد",
          "en": "points with grade equal one"
        },
        {
          "ar": "نقاط درجتها تساوي نصف",
          "en": "points with grade equal half"
        },
        {
          "ar": "نقاط درجتها تحت الصفر",
          "en": "points with grade below zero"
        }
      ],
      "concept_id": "c3_support",
      "explanation": {
        "ar": "الدعم هو كل نقطة درجتها أكبر من الصفر.",
        "en": "The support is every point whose membership grade is greater than zero."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "أي النقاط تشكّل النواة؟",
        "en": "Which points form the core?"
      },
      "bloom": "Remember",
      "answer": 1,
      "options": [
        {
          "ar": "نقاط درجتها تحت الواحد",
          "en": "points with grade below one"
        },
        {
          "ar": "نقاط درجتها تساوي واحد",
          "en": "points with grade equal one"
        },
        {
          "ar": "نقاط درجتها فوق الصفر",
          "en": "points with grade above zero"
        },
        {
          "ar": "نقاط درجتها تساوي نصف",
          "en": "points with grade equal half"
        }
      ],
      "concept_id": "c3_core",
      "explanation": {
        "ar": "النواة هي كل نقطة درجتها تساوي الواحد.",
        "en": "The core is every point whose membership grade equals one."
      }
    },
    {
      "id": "q3",
      "stem": {
        "ar": "متى تكون المجموعة الضبابية فارغة؟",
        "en": "When is a fuzzy set empty?"
      },
      "bloom": "Remember",
      "answer": 2,
      "options": [
        {
          "ar": "الدرجة نصف في كل مكان",
          "en": "grade is half everywhere"
        },
        {
          "ar": "الدرجة فوق الصفر هنا",
          "en": "grade is above zero"
        },
        {
          "ar": "الدرجة صفر في كل مكان",
          "en": "grade is zero everywhere"
        },
        {
          "ar": "الدرجة واحد في كل مكان",
          "en": "grade is one everywhere"
        }
      ],
      "concept_id": "c3_empty",
      "explanation": {
        "ar": "المجموعة الفارغة درجتها صفر عند كل نقطة في الفضاء.",
        "en": "An empty fuzzy set has membership zero at every point of the universe."
      }
    },
    {
      "id": "q4",
      "stem": {
        "ar": "متى تكون المجموعة الضبابية طبيعية؟",
        "en": "When is a fuzzy set normal?"
      },
      "bloom": "Understand",
      "answer": 3,
      "options": [
        {
          "ar": "دعمها فارغ تماماً",
          "en": "its support is empty"
        },
        {
          "ar": "ارتفاعها تحت الواحد",
          "en": "its height is below one"
        },
        {
          "ar": "درجاتها كلها صفر",
          "en": "its grades are all zero"
        },
        {
          "ar": "نواتها ليست فارغة",
          "en": "its core is not empty"
        }
      ],
      "concept_id": "c3_normal",
      "explanation": {
        "ar": "تكون طبيعية عندما تبلغ نقطة واحدة الدرجة واحد، فالنواة غير فارغة.",
        "en": "A set is normal when at least one point reaches grade one, so the core is non-empty."
      }
    },
    {
