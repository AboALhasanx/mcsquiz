    },
    {
      "id": "q6",
      "stem": {
        "ar": "ما هي المجموعة الأحادية الضبابية؟",
        "en": "What is a fuzzy singleton?"
      },
      "bloom": "Remember",
      "answer": 1,
      "options": [
        {
          "ar": "ارتفاعها تحت الواحد",
          "en": "height is below one here"
        },
        {
          "ar": "دعمها نقطة واحدة هنا",
          "en": "support is a single point"
        },
        {
          "ar": "دعمها الفضاء كله",
          "en": "support is the whole space"
        },
        {
          "ar": "نواتها فارغة تماماً",
          "en": "core is empty at all"
        }
      ],
      "concept_id": "c3_singleton",
      "explanation": {
        "ar": "المجموعة الأحادية دعمها نقطة واحدة فقط بدرجة واحد.",
        "en": "A fuzzy singleton has a support of exactly one point, with grade one there."
      }
    },
    {
      "id": "q7",
      "stem": {
        "ar": "ما هو ارتفاع المجموعة الضبابية؟",
