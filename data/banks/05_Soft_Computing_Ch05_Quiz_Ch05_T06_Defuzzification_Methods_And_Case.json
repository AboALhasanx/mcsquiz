    {
      "id": "q1",
      "stem": {
        "ar": "أي طريقة من طرائق العظمى لإزالة التغبيش؟",
        "en": "Which is a maxima defuzzification method?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "أول العظمى هنا",
          "en": "first of maxima here"
        },
        {
          "ar": "مركز الثقل هنا",
          "en": "centre of gravity here"
        },
        {
          "ar": "مركز المجاميع هنا",
          "en": "centre of sums here"
        },
        {
          "ar": "المتوسط الموزون",
          "en": "weighted average here"
        }
      ],
      "concept_id": "c5d_maxima",
      "explanation": {
        "ar": "أول العظمى طريقة من العظمى؛ والبقية تستخدم الشكل كله.",
        "en": "First-of-maxima is a maxima method; the others use the whole shape."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "ماذا يُعيد أول العظمى؟",
        "en": "What does first-of-maxima return?"
      },
      "bloom": "Understand",
      "answer": 1,
      "options": [
        {
          "ar": "مركز المساحة هنا",
          "en": "the centre of the area"
        },
        {
          "ar": "أصغر x عند القمة",
          "en": "the smallest peak x"
        },
        {
          "ar": "أكبر x عند القمة",
          "en": "the largest peak x"
        },
        {
          "ar": "متوسط x للقمة هنا",
          "en": "the mean of the peak x"
        }
      ],
      "concept_id": "c5d_fom",
      "explanation": {
        "ar": "أول العظمى يُعيد أصغر قيمة تبلغ عندها المجموعة قمتها.",
        "en": "First-of-maxima returns the smallest value at which the set reaches its peak."
      }
    },
    {
      "id": "q3",
      "stem": {
