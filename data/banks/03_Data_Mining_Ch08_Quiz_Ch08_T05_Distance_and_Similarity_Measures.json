    {
      "id": "q4",
      "stem": {
        "ar": "لـ A=(2,3) و B=(5,7)، أي مقياس يساوي 5؟",
        "en": "For A=(2,3) and B=(5,7), which measure equals 5?"
      },
      "bloom": "Apply",
      "answer": 3,
      "options": [
        {
          "ar": "مسافة مانهاتن هي",
          "en": "Manhattan distance"
        },
        {
          "ar": "تشابه جيب التمام",
          "en": "Cosine similarity"
        },
        {
          "ar": "مسافة تشيبيشيف",
          "en": "Chebyshev distance"
        },
        {
          "ar": "المسافة الإقليدية",
          "en": "Euclidean distance"
        }
      ],
      "concept_id": "c8_dis_euc_ex",
      "explanation": {
        "ar": "جذر((5-2)²+(7-3)²)=5، وهي المسافة الإقليدية.",
        "en": "sqrt((5-2)^2+(7-3)^2)=5, the Euclidean distance."
      }
    },
    {
      "id": "q5",
      "stem": {
        "ar": "مع A=(2,3) و B=(5,7)، القيمة 7 هي أي مقياس؟",
        "en": "With A=(2,3) and B=(5,7), the value 7 is which measure?"
      },
      "bloom": "Apply",
      "answer": 0,
      "options": [
        {
          "ar": "مسافة مانهاتن هي",
          "en": "Manhattan distance"
        },
        {
          "ar": "المسافة الإقليدية",
          "en": "Euclidean distance"
        },
        {
          "ar": "تشابه جيب التمام",
          "en": "Cosine similarity"
        },
        {
          "ar": "مسافة تشيبيشيف",
          "en": "Chebyshev distance"
        }
      ],
      "concept_id": "c8_dis_man_ex",
      "explanation": {
        "ar": "|5-2|+|7-3| = 7، وهي مسافة مانهاتن.",
        "en": "|5-2|+|7-3| = 7, the Manhattan distance."
      }
    },
