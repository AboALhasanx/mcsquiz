    {
      "id": "q4",
      "stem": {
        "ar": "أي قانون يصح للاتحاد والتقاطع الضبابيين؟",
        "en": "Which law holds for fuzzy union and intersection?"
      },
      "bloom": "Remember",
      "answer": 3,
      "options": [
        {
          "ar": "الوسط المرفوع يصح",
          "en": "excluded middle holds"
        },
        {
          "ar": "التناقض يصح دائماً",
          "en": "law of contradiction"
        },
        {
          "ar": "لا شيء من هذه يصح",
          "en": "none of these laws hold"
        },
        {
          "ar": "التبديل يصح دائماً",
          "en": "commutativity holds now"
        }
      ],
      "concept_id": "c4_commutativity",
      "explanation": {
        "ar": "التبديل يصح: اتحاد A و B يساوي اتحاد B و A، وكذلك التقاطع.",
        "en": "Commutativity holds: A union B equals B union A, and the same for intersection."
      }
    },
