      "id": "q1",
      "stem": {
        "ar": "ما هو الجمع المنفصل لمجموعتين ضبابيتين؟",
        "en": "What is the disjunctive sum of two fuzzy sets?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "اتحاد الفرقين معاً",
          "en": "union of two set differences"
        },
        {
          "ar": "تقاطع A و B معاً هنا",
          "en": "the intersection of A and B"
        },
        {
          "ar": "اتحاد A و B معاً هنا",
          "en": "the union of A and B here"
        },
        {
          "ar": "متمم اتحاد A و B هنا",
          "en": "the complement of A union B"
        }
      ],
      "concept_id": "c4_disjunctive",
      "explanation": {
        "ar": "الجمع المنفصل يجمع الفرقين الأحاديين، كـXOR ضبابي.",
        "en": "The disjunctive sum joins the two one-sided differences, like a fuzzy XOR."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "متى تتساوى مجموعتان ضبابيتان؟",
        "en": "When are two fuzzy sets equal?"
      },
      "bloom": "Remember",
      "answer": 1,
      "options": [
        {
          "ar": "الدعمان منفصلان هنا",
          "en": "supports are disjoint here"
        },
        {
          "ar": "الدرجات متساوية دائماً",
          "en": "grades equal at every point"
        },
        {
          "ar": "الدرجات تختلف في نقطة",
          "en": "grades differ at one point"
        },
        {
          "ar": "النواتان فارغتان هنا",
          "en": "cores are both empty here"
        }
      ],
      "concept_id": "c4_equality",
      "explanation": {
        "ar": "تتساوى المجموعتان عندما تتطابق درجاتهما عند كل نقطة.",
        "en": "Two fuzzy sets are equal when their grades match at every point."
      }
    },
