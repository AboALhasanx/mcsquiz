      },
      "bloom": "Remember",
      "answer": 2,
      "options": [
        {
          "ar": "قابلية النقل هنا أيضاً",
          "en": "portability"
        },
        {
          "ar": "قابلية الاستخدام مجدداً",
          "en": "usability"
        },
        {
          "ar": "الصحة هنا أيضاً الآن",
          "en": "correctness"
        },
        {
          "ar": "المرونة الآن مجدداً",
          "en": "flexibility"
        }
      ],
      "concept_id": "ch7_mccall_transition",
      "explanation": {
