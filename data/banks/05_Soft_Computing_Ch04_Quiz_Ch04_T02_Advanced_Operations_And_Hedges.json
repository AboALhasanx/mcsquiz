      }
    },
    {
      "id": "q3",
      "stem": {
        "ar": "ما هو الجمع الاحتمالي لدرجتين؟",
        "en": "What is the probabilistic (algebraic) sum of two grades?"
      },
      "bloom": "Remember",
      "answer": 2,
      "options": [
        {
          "ar": "أقصى قيمة بينهما",
          "en": "the maximum of a and b"
        },
        {
          "ar": "أدنى قيمة بينهما",
          "en": "the minimum of a and b"
        },
        {
          "ar": "a زائد b ناقص ab",
          "en": "a plus b minus a times b"
        },
        {
          "ar": "a زائد b زائد ab",
          "en": "a plus b plus a times b"
        }
      ],
      "concept_id": "c4_prob_sum",
      "explanation": {
        "ar": "الجمع هو a + b - ab، فـ 0.5 + 0.2 - 0.10 = 0.60.",
        "en": "The sum is a + b - ab, so 0.5 + 0.2 - 0.10 = 0.60."
      }
    },
    {
      "id": "q4",
      "stem": {
        "ar": "كيف يُعرَّف الفرق A ناقص B؟",
        "en": "How is the difference A minus B defined?"
      },
      "bloom": "Understand",
      "answer": 3,
      "options": [
        {
          "ar": "أقصى a ومتمم b",
          "en": "max of a and not b"
        },
        {
          "ar": "a ناقص b مباشرة",
          "en": "a minus b directly"
        },
        {
          "ar": "a في متمم b معاً",
          "en": "a times not b"
        },
        {
          "ar": "أدنى a ومتمم b",
          "en": "min of a and not b"
        }
      ],
      "concept_id": "c4_difference",
      "explanation": {
        "ar": "الفرق هو تقاطع A مع متمم B، أي أدنى درجة بين A ومتمم B.",
        "en": "Difference is the intersection of A with the complement of B."
      }
    },
