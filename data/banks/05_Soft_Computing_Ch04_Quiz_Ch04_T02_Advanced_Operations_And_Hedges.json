      "stem": {
        "ar": "ما هو الجداء الجبري لدرجتين؟",
        "en": "What is the algebraic product of two grades?"
      },
      "bloom": "Remember",
      "answer": 0,
      "options": [
        {
          "ar": "حاصل ضربهما المباشر",
          "en": "their simple product"
        },
        {
          "ar": "أقصى قيمة بينهما هنا",
          "en": "their maximum value"
        },
        {
          "ar": "أدنى قيمة بينهما هنا",
          "en": "their minimum value"
        },
        {
          "ar": "واحد ناقص كل منهما",
          "en": "one minus each grade"
        }
      ],
      "concept_id": "c4_alg_product",
      "explanation": {
        "ar": "الجداء الجبري يضرب الدرجتين عنصراً بعنصر.",
        "en": "The algebraic product multiplies the two grades element by element."
      }
    },
    {
      "id": "q2",
      "stem": {
        "ar": "ماذا يفعل الجداء القياسي بمجموعة ضبابية؟",
